# Agentic Commerce Copilot - Database Config
COPILOT_DATABASE_URL=postgresql+asyncpg://copilot:copilot_pass@localhost:5433/copilot_db
REDIS_URL=redis://localhost:6380

# Demo App Connection
DEMO_APP_BASE_URL=http://localhost:8000/api/v1

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_API_KEY=your_gemini_api_key_here

# Agent specific model overrides (optional)
INTENT_AGENT_MODEL=gemini-2.5-flash-native-audio-latest
PRODUCT_AGENT_MODEL=gemini-2.5-flash-native-audio-latest
SALES_AGENT_MODEL=gemini-2.5-flash-native-audio-latest
COMMERCE_AGENT_MODEL=gemini-2.5-flash-native-audio-latest
VOICE_AGENT_MODEL=gemini-2.5-flash-native-audio-latest

# WhatsApp Configuration (Mode: demo | real)
WHATSAPP_MODE=demo
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_VERSION=v17.0

# Telegram Agentic Commerce Copoilt Bot 
TELEGRAM_BOT_TOKEN=8930402939:AAG9oPGMc1wthTYIVX5wD_2x0RPbxz2Fhwk
TELEGRAM_BOT_USERNAME=AgenticCommerceCopilotBot
TELEGRAM_MODE=real

# Voice Configuration (Mode: demo | real)
VOICE_MODE=real
VOICE_PROVIDER=gemini-native-audio

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE_MINUTES=10080

# Electron App URL
ELECTRON_API_URL=http://localhost:5174
