# Environment — Copy to .env and fill in values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentic_commerce

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Razorpay TEST MODE ────────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys (Test Mode)
# Leave empty during development — app starts without them.
# Payment flow will show a clear "Razorpay not configured" error when empty.
RAZORPAY_KEY_ID=rzp_test_TUINLX4PjIDvRR
RAZORPAY_KEY_SECRET=79Eob5IUq0CdxyYjNWcHvkQ6
RAZORPAY_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Tax ───────────────────────────────────────────────────────────────────────
TAX_RATE=0.18
